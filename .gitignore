.env
.env.local
# Timestamped .env copies made before a secret rotation — same
# secrets, same rules: never in git.
.env.bak*
*/.env.bak*
# Root runtime data dir only — NOT module seed data like
# modules/forums/data/linkbase_index.json (baked into the image at build).
/data/
backups/
certs/*
!certs/.gitkeep
!certs/README.md
*.pyc
__pycache__/
node_modules/
dist/
.DS_Store
*.log
.idea/
.vscode/
.dev-license.json

# ACME challenge tokens are transient — keep the directory, not its contents.
acme-webroot/.well-known/
.platform-owner-password

# Released agent images (tarball delivery mode). ~150 MB each, rebuilt by
# scripts/release.sh from a commit that IS in git — so the artefact is
# reproducible and does not belong in the history. version.json carries
# its checksum, which is what makes the download verifiable.
data-agent/agent-image-*.tar.gz

# Release output of scripts/release.sh (served at /agent/)
data-agent/dist/
data-agent/.dist-stage*
data-agent/keycloak/import/
data-agent/.env
# Generated by setup.sh
nginx/conf.d/*.inc
.setup-state
.pytest_cache/

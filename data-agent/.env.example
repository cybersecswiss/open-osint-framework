# =============================================================
# OSINT Data Agent — environment template
# Copy to .env and fill in. .env is gitignored.
# =============================================================

# Postgres password (auto-generated by install.sh)
POSTGRES_PASSWORD=

# Connection string built from the postgres user/password
DATABASE_URL=postgresql+asyncpg://agent:<POSTGRES_PASSWORD>@postgres:5432/agent

# Shared secret with the framework backend. Must match
# API_SECRET_KEY in the framework's .env on the same deployment.
FRAMEWORK_KEY=

# Host port to expose the agent on. Customer admin chooses based on
# their existing port allocations.
AGENT_PORT=9000

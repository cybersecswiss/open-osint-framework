# =============================================================
# OOF — environment configuration (template)
# =============================================================
# Do NOT edit this by hand for a first install: run
#
#     sudo ./setup.sh
#
# which copies this file to .env, fills in every secret and the
# host/port values, and keeps them on re-runs. .env is gitignored and
# must never be committed — it holds every password of the installation.
#
# Values left empty below are generated by setup.sh.
# =============================================================

# ---------- Public address ------------------------------------
# IP address or DNS name the browser uses. Keycloak issues tokens for
# exactly this address, and the frontend is built against it — after a
# change run:  sudo ./setup.sh --reconfigure
PUBLIC_HOST=
PUBLIC_SCHEME=https
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# Derived by setup.sh: https://HOST, plus :PORT when not 443.
PUBLIC_ORIGIN=
# Keycloak: -1 when HTTPS is on 443, otherwise the port.
KC_HOSTNAME_PORT=

# ---------- PostgreSQL ----------------------------------------
POSTGRES_PASSWORD=
POSTGRES_KEYCLOAK_PASSWORD=
POSTGRES_N8N_PASSWORD=
POSTGRES_LICENSE_PASSWORD=

# ---------- Redis ---------------------------------------------
REDIS_PASSWORD=

# ---------- FastAPI -------------------------------------------
API_SECRET_KEY=

# ---------- Role-split secrets --------------------------------
# API_SECRET_KEY used to do four jobs at once (key-encryption key,
# internal service auth, updater auth, customer-agent auth). Each of the
# three below takes over one of them; leave a line out and it falls back
# to API_SECRET_KEY, so an old .env still boots. Generate each with
#   openssl rand -hex 32
# The customer-agent key is NOT here: it is the per-tenant agent_api_key
# issued by the license server at license creation.
#
# APIKEY_KEK encrypts the OSINT API keys stored in the license-server DB.
# ⚠️ NEVER edit it in place — that makes every stored key undecryptable.
# Rotate with:
#   docker compose exec -T api python - --old "<old>" --new "<new>" \
#       < scripts/rekey-apikeys.py
# then write the new value here and `bash scripts/rebuild.sh api`.
APIKEY_KEK=
# Internal service-to-service calls (backend ↔ license-server, n8n → backend).
INTERNAL_KEY=
# Updater sidecar only — it holds the Docker socket, so it gets its own key.
UPDATER_KEY=
# Keys the audit hash chain. Must NOT be stored in the database the chain
# protects — otherwise anyone with DB write access can re-chain the log.
# Entries written before this key existed keep verifying under the old
# unkeyed scheme, so introducing it is non-destructive.
AUDIT_HMAC_KEY=
# What the OPERATOR-side audit keeps of a search selector:
#   full   — verbatim (default, unchanged behaviour)
#   hashed — salted fingerprint only: the operator can correlate repeat
#            searches but cannot read what a tenant searched for
#   off    — nothing
# Organisations with strict data-sovereignty requirements want `hashed`.
AUDIT_SELECTOR_MODE=hashed

# ---------- Keycloak ------------------------------------------
# Operating mode. setup.sh writes 'production'.
ENVIRONMENT=production
# Recipient for certificate and operational notices.
ADMIN_EMAIL=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
# Product-owner realm (platform) service-account client secret.
PLATFORM_KC_CLIENT_SECRET=

# ---------- n8n -----------------------------------------------
N8N_USER=admin
N8N_PASSWORD=
N8N_API_KEY=
N8N_ENCRYPTION_KEY=

# ---------- License Server ------------------------------------
LICENSE_SECRET_KEY=

# ---------- External APIs (fill when available) ---------------
# All keys are optional — modules degrade gracefully and surface a
# clear "missing key" error instead of crashing.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=
HIBP_API_KEY=
ETHERSCAN_API_KEY=
# Shodan — host intel (ports/CVEs) + favicon-hash clustering (module-infra).
SHODAN_API_KEY=

# AI function (KI-Verknüpfung) provider. "gemini" (default) uses the n8n
# ai-link workflow + GEMINI_API_KEY (set in /glbadmin → Settings). "local"
# is the sovereign scaffold: point AI_LOCAL_BASE_URL at an OpenAI-compatible
# endpoint (Ollama/vLLM) and activate the ai-link-local n8n workflow — no
# case data leaves the customer. Leave as gemini until a local model exists.
AI_PROVIDER=gemini
# Gemini model for the AI function. gemini-3.6-flash is current + fast;
# override if your key exposes a different one (see the /v1beta/models list).
AI_GEMINI_MODEL=gemini-3.6-flash
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=llama3.1


# ---------- Darknet / Tor ------------------------------------
# module-darknet queries the onion search engines (torch, tordex, tor66)
# through the bundled `tor` SOCKS proxy — socks5h so .onion is resolved
# Tor-side. Leave the default unless you run Tor elsewhere. Set empty to
# disable the Tor path; Ahmia is searched over CLEARNET and keeps working
# either way (it also covers Tor's ~90 s bootstrap window).
TOR_SOCKS_PROXY=socks5h://tor:9050

# Filter results against Ahmia's abuse blacklist (~58k MD5-hashed onions).
# On by default so investigators are not pointed at abuse material they did
# not ask for. Set to false when such material IS the subject of the
# investigation — either way the number of withheld hits is reported in the
# search notes, never dropped silently.
DARKNET_FILTER_ABUSE=true

# Max hidden services per search that reach the graph. Ahmia alone can
# return 2500 hits for a broad term; the rest would bury the analyst. The
# notes always report how many were actually found.
DARKNET_MAX_RESULTS=40


# ---------- Telegram deep collection (optional) ----------------
# The messenger module's Telegram tools work KEYLESS out of the box
# (public web preview). Setting all three of the following unlocks the
# Telethon-backed deep path: full message history, views/forwards/reply
# metadata, real channel discovery, in-channel full-history search,
# auto-translation and media download. Generate the StringSession ONCE
# out of band — see docs/operations.en.md "Telegram deep collection".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Translate non-target-language posts (needs the deep path). Target is a
# 2-letter code; "en" default, "de" for German-first review.
TELEGRAM_TRANSLATE=false
TELEGRAM_TRANSLATE_TARGET=en
# Download post media (photos/videos) and offer a ZIP (deep path only).
TELEGRAM_DOWNLOAD_MEDIA=false
TELEGRAM_MAX_MEDIA_MB=50
# Same cap in bytes, used by module-telegram (the two are independent —
# MODULE_MAX_MEDIA_MB is module-messenger's).
TELEGRAM_MAX_MEDIA_BYTES=20971520
# Default max messages collected per channel (deep path).
TELEGRAM_DEFAULT_LIMIT=200
# Seconds to wait between channels while scanning (rate-limit courtesy).
TELEGRAM_DELAY_BETWEEN_CHANNELS=2
# Username/alias hunt across known crime channels (tool
# telegram_username_hunt, hooks the `username` query type). The curated
# channel list lives in modules/messenger/config/crime_channels.txt
# (bind-mounted, edited live). This var extends/overrides it ad hoc:
TELEGRAM_CRIME_CHANNELS=
TELEGRAM_HUNT_MAX_CHANNELS=40
TELEGRAM_HUNT_CONCURRENCY=8
TELEGRAM_HUNT_PER_CHANNEL_LIMIT=60

# ---------- Grafana -------------------------------------------
GRAFANA_PASSWORD=

# ---------- Backend internal URLs -----------------------------
# Hostnames resolve via Docker's internal DNS. Override only if a
# component lives outside the docker network.
N8N_URL=http://n8n:5678
LICENSE_SERVER_URL=http://license:9000
MODULE_ALIAS_URL=http://module-alias:8010
MODULE_LEAKS_URL=http://module-leaks:8020
MODULE_INFRA_URL=http://module-infra:8030
MODULE_THREAT_URL=http://module-threat:8050
MODULE_DARKNET_URL=http://module-darknet:8060
MODULE_MESSENGER_URL=http://module-messenger:8070
MODULE_CRYPTO_URL=http://module-crypto:8080
# module-telegram: authenticated MTProto scanner (needs TELEGRAM_API_ID/HASH
# + a pre-built session file bind-mounted at modules/telegram/session/).
MODULE_TELEGRAM_URL=http://module-telegram:8090
MODULE_COMPLIANCE_URL=http://module-compliance:8100
MODULE_FORUMS_URL=http://module-forums:8110
MODULE_DATING_URL=http://module-dating:8130
MODULE_IMAGE_URL=http://module-image:8120
MODULE_NEWS_URL=http://module-news:8140
MODULE_CORPORATE_URL=http://module-corporate:8150

# --- module-news: RSS/news search -------------------------------
# Feed list is maintained in the Owner console (Settings -> RSS);
# modules/news/feeds.json is the fallback when none is stored.
NEWS_MAX_RESULTS=60
# Ignore entries older than this many days (default 5 years).
NEWS_MAX_AGE_DAYS=1825
NEWS_FEED_TIMEOUT=25
NEWS_CONCURRENCY=8

# ---------- Platform realm (Product-Owner console) -----------------
# The /glbadmin console authenticates against a SEPARATE Keycloak realm
# from the tenant app. Created imperatively by scripts/configure-keycloak.sh,
# not by the realm export. PLATFORM_KC_CLIENT_SECRET is set further up.
PLATFORM_REALM=platform
PLATFORM_KC_CLIENT_ID=platform-backend

# ---------- Customer-IdP TLS ----------------------------------------
# Verify the customer Keycloak's certificate when validating their
# tokens. Set to false ONLY in a test setup with self-signed customer certs.
TLS_VERIFY_IDP=true


# ---------- Sanctions screening (module-compliance) ---------------
# Empty key = the public rate-limited endpoint. OPENSANCTIONS_BASE can
# point at a self-hosted yente instance instead (no key needed then).
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_BASE=https://api.opensanctions.org

# ---------- Crime-forum seed list (module-forums) -----------------
# The forum list for crime_forum_hunt resolves in three steps:
#   1. the operator's list in Global-Admin -> Settings -> "Foren-Liste"
#   2. CRIME_FORUMS below (comma-separated hosts), for installs with no
#      console access or for a quick override
#   3. the list built into the runner
# Normally leave this empty and manage the forums in the console — crime
# forums change domain several times a year and that beats a redeploy.
CRIME_FORUMS=
# Max forums searched per hunt (one search-engine query each). Applied by
# module-forums AND displayed by the console, from this one variable.
CRIME_FORUM_MAX=40
# Seconds one hunt may take before it returns what it has. Must stay BELOW
# the orchestrator's 300 s timeout for a "slow" tool — otherwise the caller
# discards the run and reports the module as unreachable instead of showing
# the partial result.
CRIME_FORUM_BUDGET=240

# ---------- Per-tenant data-agent URL (optional override) ---
# Normally the license server stores each tenant's data-server URL
# (set in /glbadmin). AGENT_URL_<TENANT> overrides it; tenant name
# upper-cased, '-' becomes '_'.
AGENT_URL_DEFAULT=

# Verify the TLS certificate of customer data servers. Set to false
# only when data servers run with self-signed certificates (LAN/test).
TLS_VERIFY_AGENT=true

# ── Alert delivery ─────────────────────────────────────────────────
# LICENSE_KEK — key-encryption key for CUSTOMER secrets stored in the
# licence DB: idp_backend_secret, the SMTP password and the alert-webhook
# secret a customer enters in /admin → Settings.
# Unset falls back to API_SECRET_KEY, so an existing deployment keeps
# working. ⚠️ Rotating it makes every stored ciphertext unreadable —
# there is no re-encryption path.
LICENSE_KEK=

# NOTIFY_ALLOW_PRIVATE_TARGETS — alert webhooks are refused when the URL
# resolves to a private address, because the request leaves from inside
# the operator's docker network where internal services are reachable.
# Only a local test setup with a private receiver needs this. Leave false.
NOTIFY_ALLOW_PRIVATE_TARGETS=false

# ---------- Sensitive tools — OFF by default ----------------------
# These three tools are deliberately disabled in a fresh installation.
# Enable one only if you have a legal basis for its use, then run
#   docker compose up -d module-infra module-darknet module-dating
# While a switch is false the tool does not appear in the search form and
# direct calls are refused.
#
# origin_resolve — finds the real server behind a CDN (Cloudflare & co.) by
# probing candidate addresses DIRECTLY from this server, including
# third-party hosts (mail servers, shared hosting). Visible to the target.
ENABLE_ORIGIN_RESOLVE=false
# onion_scrape — reads the text content of a hidden service over Tor and
# extracts contacts, wallets and links. Services on Ahmia's abuse blacklist
# are always refused; nothing is fetched if the list cannot be loaded.
ENABLE_ONION_SCRAPE=false
ONION_SCRAPE_MAX_PAGES=3
ONION_SCRAPE_MAX_BYTES=2000000
ONION_SCRAPE_TIMEOUT=60
# cupidcrawl (module dating) — checks a username on dating and adult
# platforms. ⚠️ Results reveal information about a person's sex life, a
# special category of personal data (FADP art. 5 c, GDPR art. 9).
ENABLE_DATING_SEARCH=false
